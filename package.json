{
  "name": "vue-crud-fullstack",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "docker-compose up frontend-dev backend-dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "build": "cd frontend && npm run build",
    "preview": "cd frontend && npm run preview",
    "test": "cd frontend && npm run test",
    "cypress:open": "cd frontend && npm run cypress:open",
    "cypress:run": "cd frontend && npm run cypress:run",
    "test:e2e": "cd frontend && npm run test:e2e",
    "test:e2e:open": "cd frontend && npm run test:e2e:open",
    "test:e2e:ci": "cd frontend && npm run test:e2e:ci",
    "test:component": "cd frontend && npm run test:component",
    "test:component:open": "cd frontend && npm run test:component:open",
    "docker:dev": "docker-compose up frontend-dev backend-dev",
    "docker:prod": "docker-compose -f docker-compose.yml -f docker-compose.prod.yml up frontend-prod backend-prod nginx",
    "docker:test": "docker-compose --profile testing up",
    "docker:setup": "chmod +x scripts/docker-setup.sh && ./scripts/docker-setup.sh",
    "docker:build": "docker-compose build",
    "docker:clean": "docker-compose down -v --remove-orphans && docker system prune -f",
    "install:frontend": "cd frontend && npm install",
    "install:backend": "cd backend && npm install",
    "install:all": "npm run install:frontend && npm run install:backend"
  }
}
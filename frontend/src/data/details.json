{
    "$id": "details.json",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "array",
    "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
            "id": {
                "type": "integer",
                "description": "Auto generated id."
            },
            "name": {
                "description": "A headline summarizing the description",
                "type": "string"
            },
            "description": {
                "description": "A JSON object representing TipTap editor documents/data",
                "type": "object",
                "default": {}
            },
            "tags": {
                "description": "Specific typed tags related to this detail object.",
                "type": "array",
                "items": {"$ref": "entities.json"},
                "uniqueItems": true,
                "default": []
            
            },
            "details":{
                "type": "array",
                "default": [],
                "items": { "$ref": "#" }
            }
        }
        
    }
}

{
    "$id": "positions.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "A representation of a position",
    "title": "Position",
    "type": "object",
    "required": ["id", "name", "start_year"],
    "additionalProperties": true,
    "properties": {
        "id": {
            "type": "integer",
            "description": "Auto generated id."
        },
        "name": {
            "type": "string",
            "description": "The position title"
        },
        "start_year": {
            "type": "integer"
        },
        "start_month": {
            "type": "integer"
        },
        "start_day": {
            "type": "integer"
        },
        "end_year": {
            "type": "integer"
        },
        "end_month": {
            "type": "integer"
        },
        "end_day": {
            "type": "integer"
        },
        "salary": { 
            "type": "number" 
            },    
        "additional_properties": {
            "type": "object"
        },

        "details":
            { "$ref": "details.json", "default":[] }
    }
}